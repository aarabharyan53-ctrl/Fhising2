<script>
const API='api', CSRF="{{ csrf }}";
let ADS=[], AD_ENABLED=true, VIDEOS={{ videos | tojson }};
let LOG_LAST=0, LOG_PAUSED=false, LOG_FILTER='all';

function openModal(id){
  document.getElementById(id).classList.add('active');
  if(id==='adsModal') loadAds();
  if(id==='videosModal') renderVideos();
}
function closeModal(id){ document.getElementById(id).classList.remove('active'); }
function closeModalOnOverlay(e,id){ if(e.target.id===id) closeModal(id); }

function showToast(m,type='success'){
  const t=document.createElement('div'); t.className=`toast ${type}`; t.textContent=m;
  document.getElementById('toastContainer').appendChild(t);
  setTimeout(()=>t.remove(),3200);
}
function esc(s){const d=document.createElement('div');d.textContent=s==null?'':s;return d.innerHTML;}
function validUrl(u){return /^https?:\/\/.+/.test(u);}

async function api(path,opts={}){
  opts.headers=Object.assign({},opts.headers,{'X-CSRF-Token':CSRF});
  let r;
  try{ r=await fetch(`${API}${path}`,opts); }
  catch(e){ showToast('Network error','error'); return {success:false}; }
  if(r.status===401){ location.href='login'; return {success:false}; }
  try{ return await r.json(); }catch{ return {success:false,error:'bad response'}; }
}
async function withBusy(btn,fn){
  const prev=btn?btn.innerHTML:null;
  if(btn){btn.disabled=true;btn.innerHTML='<span class="spin"></span>';}
  try{ return await fn(); } finally { if(btn){btn.disabled=false;btn.innerHTML=prev;} }
}

function setScheduler(running){
  const b=document.getElementById('sysBadge');
  b.classList.toggle('online',running); b.classList.toggle('offline',!running);
  b.textContent=running?'Scheduler Running':'Scheduler Idle';
  document.getElementById('toggleSwitch').classList.toggle('active',running);
  document.getElementById('toggleStatus').textContent=running?'Running':'Stopped';
  document.getElementById('statBroadcast').textContent=running?'ACTIVE':'PAUSED';
}
async function toggleAds(){
  const w=document.getElementById('toggleWrap'); w.style.pointerEvents='none';
  const d=await api('/toggle-ads',{method:'POST'}); w.style.pointerEvents='';
  if(d.success){ setScheduler(d.enabled); showToast(d.message); } else showToast(d.error||'Failed','error');
}
async function toggleDelete(){
  const w=document.getElementById('delWrap'); w.style.pointerEvents='none';
  const d=await api('/toggle-delete-after-round',{method:'POST'}); w.style.pointerEvents='';
  if(d.success){
    document.getElementById('delSwitch').classList.toggle('active',d.delete_after_round);
