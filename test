    c = get_ads_config()
    new = not c.get("ads_enabled", False)
    if not update_ads_config({"ads_enabled": new}):
        return jsonify({"success": False, "error": "update failed"}), 500
    if users_col is not None:
        users_col.update_many({}, {"$set": {"ads_enabled": new}})
    if new:
