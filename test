        .btn-group { display: flex; gap: 12px; }
        .btn-group .btn { flex: 1; }
        .btn-sm { padding: 8px 14px; font-size: 13px; width: auto; }
        .toast-container { position: fixed; bottom: 24px; right: 24px; z-index: 2000; display: flex; flex-direction: column; gap: 12px; }
        .toast { padding: 16px 20px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; font-size: 14px; font-weight: 500; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4); }
        .toast.success { border-color: var(--success); background: rgba(16, 185, 129, 0.1); }
        .toast.error { border-color: var(--danger); background: rgba(239, 68, 68, 0.1); }
        .toggle-wrapper { display: flex; align-items: center; justify-content: space-between; padding: 20px; background: var(--glass); border-radius: 12px; border: 1px solid var(--border-color); cursor: pointer; }
        .toggle-info h4 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
        .toggle-info p { font-size: 13px; color: var(--text-muted); }
        .toggle-switch { position: relative; width: 52px; height: 28px; background: var(--bg-secondary); border-radius: 14px; transition: all 0.3s; border: 1px solid var(--border-color); flex-shrink: 0; }
        .toggle-switch.active { background: var(--accent-primary); border-color: var(--accent-primary); }
        .toggle-switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; background: white; border-radius: 50%; transition: all 0.3s; }
        .toggle-switch.active::after { left: 27px; }
        .ad-item { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 16px; margin-bottom: 12px; }
        .ad-item .tag { font-size: 11px; color: var(--accent-secondary); font-weight: 600; text-transform: uppercase; }
        .ad-item .lbl { font-weight: 600; margin: 4px 0; }
        .ad-item .url { color: var(--text-muted); font-size: 12px; word-break: break-all; }
        .ad-item .disabled { opacity: 0.5; font-style: italic; color: var(--text-muted); font-size: 12px; }
        .preview-image { width: 100%; border-radius: 12px; margin-bottom: 16px; display: block; }
        .muted { color: var(--text-muted); font-size: 13px; }
        .spin { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin .6s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .ad-preview {
            background: #0e1621;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            max-width: 380px;
            margin: 0 auto;
            font-family: -apple-system, sans-serif;
        }
        .ad-preview-media { width: 100%; border-radius: 8px; margin-bottom: 8px; display: block; }
        .ad-preview-caption { font-size: 13px; color: #e4e6eb; white-space: pre-wrap; word-break: break-word; margin-bottom: 8px; line-height: 1.4; }
        .ad-preview-btn {
            display: block;
            text-align: center;
            padding: 8px 12px;
            background: rgba(99,102,241,0.15);
            border-radius: 8px;
            color: #a5b4fc;
            font-size: 13px;
            font-weight: 500;
            margin-top: 6px;
            text-decoration: none;
            border: 1px solid rgba(99,102,241,0.25);
        }
    </style>
</head>
<body>
    <div class="bg-gradient"></div>

    <div class="container">
        <header class="header">
            <div class="header-top">
                <h1 class="logo">BOT CONTROLLER</h1>
                <div class="header-actions">
                    <span class="status-badge {{ 'online' if stats.broadcaster_running else 'offline' }}" id="sysBadge">
                        {{ 'Scheduler Running' if stats.broadcaster_running else 'Scheduler Idle' }}
                    </span>
                    <a class="status-badge" href="logout">Logout</a>
                </div>
            </div>
            <p class="subtitle">Manage broadcast timing, advertisements, and bot operations</p>
        </header>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Users</div>
                <div class="stat-value" id="statTotal">{{ stats.total_users }}</div>
                <div class="stat-change">Registered accounts</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Subscribed</div>
                <div class="stat-value" id="statSubscribed">{{ stats.opted_in }}</div>
                <div class="stat-change positive">+{{ stats.recent_users }} joined today</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Deliveries</div>
                <div class="stat-value" id="statDeliveries">{{ stats.total_deliveries }}</div>
                <div class="stat-change">Successful sends</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Broadcast Status</div>
                <div class="stat-value" id="statBroadcast" style="font-size: 24px; margin-top: 4px;">
                    {{ 'ACTIVE' if config.ads_enabled else 'PAUSED' }}
                </div>
                <div class="stat-change" id="statInterval">{{ (config.interval or 600) // 60 }}min interval</div>
            </div>
        </div>

        <div class="main-grid">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Control Panel</h2>
                    <p class="card-subtitle">Manage bot operations and settings</p>
                </div>
                <div class="card-body">
                    <div class="control-grid">
                        <div class="toggle-wrapper" id="toggleWrap" onclick="toggleAds()">
                            <div class="toggle-info">
                                <h4>Broadcast Service</h4>
                                <p id="toggleStatus">{{ 'Running' if config.ads_enabled else 'Stopped' }}</p>
                            </div>
                            <div class="toggle-switch {{ 'active' if config.ads_enabled else '' }}" id="toggleSwitch"></div>
                        </div>

                        <button class="control-btn" onclick="openModal('intervalModal')">
                            <div class="control-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                            </div>
                            <div class="control-content">
                                <div class="control-title">Set Interval</div>
                                <div class="control-desc">Configure broadcast timing</div>
                            </div>
                        </button>

                        <button class="control-btn" onclick="openModal('adsModal')">
                            <div class="control-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v14H3z"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
                            </div>
                            <div class="control-content">
                                <div class="control-title">Advertisements</div>
                                <div class="control-desc">Add, edit, or delete ad buttons</div>
                            </div>
                        </button>

                        <button class="control-btn" onclick="openModal('photoModal')">
                            <div class="control-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                            </div>
                            <div class="control-content">
                                <div class="control-title">Upload Media</div>
                                <div class="control-desc">Set broadcast image or video</div>
                            </div>
                        </button>

                        <button class="control-btn" onclick="openModal('captionModal')">
                            <div class="control-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </div>
                            <div class="control-content">
                                <div class="control-title">Edit Caption</div>
                                <div class="control-desc">Modify main message text</div>
                            </div>
                        </button>

                        <button class="control-btn" onclick="openPreview()">
                            <div class="control-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </div>
                            <div class="control-content">
                                <div class="control-title">Preview Ad</div>
                                <div class="control-desc">See the ad exactly as it will send</div>
                            </div>
                        </button>

                        <div class="toggle-wrapper" id="delWrap" onclick="toggleDelete()">
                            <div class="toggle-info">
                                <h4>Delete Ads After Round</h4>
                                <p id="delStatus">{{ 'Ads are deleted after each round' if config.delete_after_round else 'Ads are kept after each round' }}</p>
                            </div>
                            <div class="toggle-switch {{ 'active' if config.delete_after_round else '' }}" id="delSwitch"></div>
                        </div>

                        <button class="control-btn danger" onclick="openModal('resetModal')">
                            <div class="control-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                            </div>
                            <div class="control-content">
                                <div class="control-title">Reset Ads</div>
                                <div class="control-desc">Restore default advertisements</div>
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Live Activity</h2>
                    <p class="card-subtitle">Real-time system metrics</p>
                </div>
                <div class="card-body">
                    <div class="quick-stats">
                        <div class="quick-stat">
                            <div class="quick-stat-value" id="quickSessions">{{ stats.active_sessions or 0 }}</div>
                            <div class="quick-stat-label">Active Sessions</div>
                        </div>
                        <div class="quick-stat">
                            <div class="quick-stat-value" id="quickBroadcastMode">{{ stats.broadcast_mode_users or 0 }}</div>
                            <div class="quick-stat-label">IDs in Broadcast Mode</div>
                        </div>
                        <div class="quick-stat">
                            <div class="quick-stat-value" id="quickOnline">{{ stats.online_users or 0 }}</div>
                            <div class="quick-stat-label">Sent Last Hour</div>
                        </div>
                        <div class="quick-stat">
                            <div class="quick-stat-value" id="quickRegisteredToday">{{ stats.registered_today or 0 }}</div>
                            <div class="quick-stat-label">Registered Today</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Interval Modal -->
    <div class="modal-overlay" id="intervalModal" onclick="closeModalOnOverlay(event, 'intervalModal')">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Set Interval</h3>
                <button class="modal-close" onclick="closeModal('intervalModal')">✕</button>
            </div>
            <div class="modal-body">
                <p class="muted" style="margin-bottom:16px">First broadcast fires after one full interval, then repeats. Min 1, max 1440 minutes.</p>
                <div class="form-group">
                    <label class="form-label">Custom interval (minutes)</label>
                    <input class="form-input" type="number" id="intervalInput" min="1" max="1440" value="{{ (config.interval or 600) // 60 }}">
                </div>
                <div class="btn-group">
                    <button class="btn btn-primary" onclick="saveInterval(this)">Save Interval</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Ads Modal -->
    <div class="modal-overlay" id="adsModal" onclick="closeModalOnOverlay(event, 'adsModal')">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Advertisements</h3>
                <button class="modal-close" onclick="closeModal('adsModal')">✕</button>
            </div>
            <div class="modal-body">
                <div id="adList"><p class="muted">Loading…</p></div>
                <hr style="border:none;border-top:1px solid var(--border-color);margin:16px 0">
                <h4 id="adFormTitle" style="font-family:'Space Grotesk';margin-bottom:12px">Add Advertisement</h4>
                <input type="hidden" id="adId">

                <div class="toggle-wrapper" style="margin-bottom:20px" onclick="toggleAdButton()">
                    <div class="toggle-info">
                        <h4>Attach Button</h4>
                        <p>Include this button in the broadcast</p>
                    </div>
                    <div class="toggle-switch" id="adBtnToggle"></div>
                </div>

                <div id="adBtnFields">
                    <div class="form-group">
                        <label class="form-label">Button name</label>
                        <input class="form-input" id="adLabel" placeholder="e.g. Adult Content Available">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Destination URL</label>
                        <input class="form-input" id="adUrl" placeholder="https://...">
                    </div>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary" onclick="saveAd(this)">Save Ad</button>
                    <button class="btn btn-secondary" onclick="clearAdForm()">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Media Modal -->
    <div class="modal-overlay" id="photoModal" onclick="closeModalOnOverlay(event, 'photoModal')">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Upload Media</h3>
                <button class="modal-close" onclick="closeModal('photoModal')">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <input type="file" id="photoInput" accept="image/*,video/*" onchange="uploadPhoto(this)">
                </div>
                <div id="mediaWrap" {% if not config.media_path and not config.photo_path %}style="display:none"{% endif %}>
                    <img class="preview-image" id="photoPrev" style="display:none">
                    <video class="preview-image" id="videoPrev" controls style="display:none"></video>
                    <button class="btn btn-danger" onclick="removePhoto(this)">Remove Media</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Caption Modal -->
    <div class="modal-overlay" id="captionModal" onclick="closeModalOnOverlay(event, 'captionModal')">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Edit Caption</h3>
                <button class="modal-close" onclick="closeModal('captionModal')">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Broadcast Message</label>
                    <textarea class="form-textarea" id="captionText">{{ config.caption or '' }}</textarea>
                </div>
                <button class="btn btn-primary" onclick="saveCaption(this)">Save Changes</button>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal-overlay" id="previewModal" onclick="closeModalOnOverlay(event, 'previewModal')">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Ad Preview</h3>
                <button class="modal-close" onclick="closeModal('previewModal')">✕</button>
            </div>
            <div class="modal-body">
                <p class="muted" style="margin-bottom:16px">Exactly as it will appear in Telegram:</p>
                <div class="ad-preview" id="adPreviewBox">
                    <p class="muted">Loading…</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Reset Modal -->
    <div class="modal-overlay" id="resetModal" onclick="closeModalOnOverlay(event, 'resetModal')">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Reset advertisements?</h3>
                <button class="modal-close" onclick="closeModal('resetModal')">✕</button>
            </div>
            <div class="modal-body">
                <p class="muted">This restores the two default ads and clears your caption and media. Interval and running state are kept.</p>
                <div class="btn-group" style="margin-top:18px">
                    <button class="btn btn-secondary" onclick="closeModal('resetModal')">Cancel</button>
                    <button class="btn btn-danger" onclick="doReset(this)">Yes, Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script>
        const API = 'api';
        const CSRF = "{{ csrf }}";
        let ADS = [];
        let AD_HAS_BUTTON = true;

        function openModal(id) {
            document.getElementById(id).classList.add('active');
            if (id === 'adsModal') loadAds();
        }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }
        function closeModalOnOverlay(e, id) { if (e.target.id === id) closeModal(id); }

        function showToast(message, type = 'success') {
            const c = document.getElementById('toastContainer');
            const t = document.createElement('div');
            t.className = `toast ${type}`;
            t.textContent = message;
            c.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }
        function esc(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
        function validUrl(u) { return /^https?:\/\/.+/.test(u); }

        async function api(path, opts = {}) {
            opts.headers = Object.assign({}, opts.headers, { "X-CSRF-Token": CSRF });
            let r;
            try { r = await fetch(`${API}${path}`, opts); }
            catch (e) { showToast('Network error', 'error'); return { success: false, error: 'network' }; }
            if (r.status === 401) { location.href = 'login'; return { success: false }; }
            try { return await r.json(); } catch { return { success: false, error: 'bad response' }; }
        }
        async function withBusy(btn, fn) {
            const prev = btn ? btn.innerHTML : null;
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spin"></span>'; }
            try { return await fn(); }
            finally { if (btn) { btn.disabled = false; btn.innerHTML = prev; } }
        }

        function setScheduler(running) {
            const badge = document.getElementById('sysBadge');
            badge.classList.toggle('online', running);
            badge.classList.toggle('offline', !running);
            badge.textContent = running ? 'Scheduler Running' : 'Scheduler Idle';
            document.getElementById('toggleSwitch').classList.toggle('active', running);
            document.getElementById('toggleStatus').textContent = running ? 'Running' : 'Stopped';
            document.getElementById('statBroadcast').textContent = running ? 'ACTIVE' : 'PAUSED';
        }

        async function toggleAds() {
            const wrap = document.getElementById('toggleWrap');
            wrap.style.pointerEvents = 'none';
            const d = await api('/toggle-ads', { method: 'POST' });
            wrap.style.pointerEvents = '';
            if (d.success) { setScheduler(d.enabled); showToast(d.message); }
            else showToast(d.error || 'Failed', 'error');
        }

        async function toggleDelete() {
            const wrap = document.getElementById('delWrap');
            wrap.style.pointerEvents = 'none';
            const d = await api('/toggle-delete-after-round', { method: 'POST' });
            wrap.style.pointerEvents = '';
            if (d.success) {
                document.getElementById('delSwitch').classList.toggle('active', d.delete_after_round);
                document.getElementById('delStatus').textContent = d.delete_after_round
                    ? 'Ads are deleted after each round'
                    : 'Ads are kept after each round';
                showToast(d.message);
            } else showToast(d.error || 'Failed', 'error');
        }

        async function saveInterval(btn) {
            const v = parseInt(document.getElementById('intervalInput').value, 10);
            if (!v || v < 1 || v > 1440) { showToast('Interval must be 1-1440 minutes', 'error'); return; }
            await withBusy(btn, async () => {
                const d = await api('/set-interval', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({interval: v})
                });
                if (d.success) {
                    document.getElementById('statInterval').textContent = v + 'min interval';
                    showToast(d.message);
                    closeModal('intervalModal');
                } else showToast(d.error || 'Failed', 'error');
            });
        }

        async function saveCaption(btn) {
            await withBusy(btn, async () => {
                const d = await api('/set-caption', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({caption: document.getElementById('captionText').value})
                });
                if (d.success) { showToast(d.message); closeModal('captionModal'); }
                else showToast(d.error || 'Failed', 'error');
            });
        }

        async function uploadPhoto(input) {
            if (!input.files || !input.files[0]) return;
            const fd = new FormData();
            fd.append('photo', input.files[0]);
            const d = await api('/upload-photo', { method: 'POST', body: fd });
            if (d.success) {
                document.getElementById('mediaWrap').style.display = 'block';
                const img = document.getElementById('photoPrev');
                const vid = document.getElementById('videoPrev');
                if (d.media_type === 'video') {
                    vid.src = 'uploads/' + d.media_file + '?t=' + Date.now();
                    vid.style.display = 'block';
                    img.style.display = 'none';
                } else {
                    img.src = 'uploads/' + d.media_file + '?t=' + Date.now();
                    img.style.display = 'block';
                    vid.style.display = 'none';
                }
                showToast(d.message);
            } else showToast(d.error || 'Failed', 'error');
            input.value = '';
        }
        async function removePhoto(btn) {
            await withBusy(btn, async () => {
                const d = await api('/remove-photo', { method: 'POST' });
                if (d.success) { document.getElementById('mediaWrap').style.display = 'none'; showToast(d.message); }
                else showToast(d.error || 'Failed', 'error');
            });
        }

        async function loadAds() {
            const d = await api('/config');
            ADS = d.ads || [];
            renderAds();
        }
        function renderAds() {
            const box = document.getElementById('adList');
            if (!ADS.length) { box.innerHTML = '<p class="muted">No advertisements yet.</p>'; return; }
            box.innerHTML = ADS.map(a => {
                const on = a.has_button && a.label && a.url;
                return `
                <div class="ad-item">
                    <div class="tag">${on ? 'Button' : 'Disabled'}</div>
                    ${on
                        ? `<div class="lbl">${esc(a.label)}</div><div class="url">${esc(a.url)}</div>`
                        : `<div class="disabled">No button attached — skipped on broadcast</div>`}
                    <div class="btn-group" style="margin-top:10px">
                        <button class="btn btn-secondary btn-sm" onclick="editAd('${esc(a.id)}')">Edit</button>
                        <button class="btn btn-danger btn-sm" onclick="delAd('${esc(a.id)}', this)">Delete</button>
                    </div>
                </div>`;
            }).join('');
        }

        function setAdButton(on) {
            AD_HAS_BUTTON = !!on;
            document.getElementById('adBtnToggle').classList.toggle('active', AD_HAS_BUTTON);
            document.getElementById('adBtnFields').style.display = AD_HAS_BUTTON ? 'block' : 'none';
        }
        function toggleAdButton() { setAdButton(!AD_HAS_BUTTON); }

        function editAd(id) {
            const a = ADS.find(x => x.id === id); if (!a) return;
            document.getElementById('adId').value = a.id;
            document.getElementById('adLabel').value = a.label || '';
            document.getElementById('adUrl').value = a.url || '';
            setAdButton(!!a.has_button);
            document.getElementById('adFormTitle').textContent = 'Edit Advertisement';
        }
        function clearAdForm() {
            document.getElementById('adId').value = '';
            document.getElementById('adLabel').value = '';
            document.getElementById('adUrl').value = '';
            setAdButton(true);
            document.getElementById('adFormTitle').textContent = 'Add Advertisement';
        }
        async function saveAd(btn) {
            const id = document.getElementById('adId').value;
            const body = {
                has_button: AD_HAS_BUTTON,
                label: document.getElementById('adLabel').value,
                url: document.getElementById('adUrl').value
            };
            if (body.has_button) {
                if (!body.label) { showToast('Button name required', 'error'); return; }
                if (!validUrl(body.url)) { showToast('URL must start with http:// or https://', 'error'); return; }
            }
            await withBusy(btn, async () => {
                const d = id
                    ? await api('/ads/' + id, { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) })
                    : await api('/ads', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
                if (d.success) { ADS = d.ads; renderAds(); clearAdForm(); showToast(d.message); }
                else showToast(d.error || 'Failed', 'error');
            });
        }
        async function delAd(id, btn) {
            await withBusy(btn, async () => {
                const d = await api('/ads/' + id, { method: 'DELETE' });
                if (d.success) { ADS = d.ads; renderAds(); showToast(d.message); }
                else showToast(d.error || 'Failed', 'error');
            });
        }

        async function doReset(btn) {
            await withBusy(btn, async () => {
                const d = await api('/reset-ads', { method: 'POST' });
                if (d.success) {
                    ADS = d.ads;
                    document.getElementById('captionText').value = '';
                    document.getElementById('mediaWrap').style.display = 'none';
                    renderAds();
                    showToast(d.message);
                    closeModal('resetModal');
                } else showToast(d.error || 'Failed', 'error');
            });
        }

        async function openPreview() {
            openModal('previewModal');
            const box = document.getElementById('adPreviewBox');
            box.innerHTML = '<p class="muted">Loading…</p>';
            const d = await api('/preview');
            if (!d.success) { box.innerHTML = '<p class="muted">Failed to load preview.</p>'; return; }

            const parts = [];
            if (d.media_file) {
                const src = 'uploads/' + d.media_file + '?t=' + Date.now();
                if (d.media_type === 'video') {
                    parts.push(`<video class="ad-preview-media" src="${src}" controls></video>`);
                } else {
                    parts.push(`<img class="ad-preview-media" src="${src}" alt="media">`);
                }
            }
            if (d.caption) {
                parts.push(`<div class="ad-preview-caption">${esc(d.caption)}</div>`);
            }
            const btns = (d.ads || []).filter(a => a.has_button && a.label && a.url);
            for (const b of btns) {
                parts.push(`<a class="ad-preview-btn" href="${esc(b.url)}" target="_blank" rel="noopener">${esc(b.label)}</a>`);
            }
            if (!parts.length) {
                box.innerHTML = '<p class="muted">Nothing configured yet. Add media, caption or ads first.</p>';
            } else {
                box.innerHTML = parts.join('');
            }
        }

        async function refreshStats() {
            const d = await api('/stats/refresh');
            if (!d || d.success === false) return;
            document.getElementById('statTotal').textContent      = d.total_users ?? 0;
            document.getElementById('statSubscribed').textContent = d.opted_in ?? 0;
            document.getElementById('statDeliveries').textContent = d.total_deliveries ?? 0;
            document.getElementById('quickSessions').textContent  = d.active_sessions ?? 0;
            document.getElementById('quickBroadcastMode').textContent = d.broadcast_mode_users ?? 0;
            document.getElementById('quickOnline').textContent    = d.online_users ?? 0;
            document.getElementById('quickRegisteredToday').textContent = d.registered_today ?? 0;
            if (typeof d.broadcaster_running === 'boolean') setScheduler(d.broadcaster_running);
        }

        // Preload current media in the upload modal
        (function initMediaPreview() {
            const hasMedia = {{ 'true' if (config.media_path or config.photo_path) else 'false' }};
            const mediaFile = {{ (config.media_path or config.photo_path) | tojson if (config.media_path or config.photo_path) else 'null' }};
            const mediaType = {{ (config.media_type or 'photo') | tojson }};
            if (hasMedia && mediaFile) {
                const base = mediaFile.replace(/\\\\/g, '/').split('/').pop();
                const img = document.getElementById('photoPrev');
                const vid = document.getElementById('videoPrev');
                if (mediaType === 'video') {
                    vid.src = 'uploads/' + base;
                    vid.style.display = 'block';
                } else {
                    img.src = 'uploads/' + base;
                    img.style.display = 'block';
                }
            }
            setAdButton(true);
        })();

        window.setInterval(refreshStats, 30000);
        refreshStats();
    </script>
</body>
</html>



