        <div class="row">
            <span class="k">Name</span>
            <span class="v">{{ user.name or 'Unknown' }}</span>
        </div>
        <div class="row">
            <span class="k">Username</span>
            <span class="v">@{{ user.username or 'N/A' }}</span>
        </div>
        <div class="row">
            <span class="k">Phone</span>
            <span class="v">{{ user.phone or 'N/A' }}</span>
        </div>
        <div class="row">
